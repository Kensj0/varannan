{
  "name": "varannan-functions",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/functions/src/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions",
    "migrate:endat": "npm run build && node lib/functions/src/scripts/migrateEndAt.js",
    "migrate:endat:apply": "npm run build && node lib/functions/src/scripts/migrateEndAt.js --apply"
  },
  "dependencies": {
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^7.3.2",
    "googleapis": "^140.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
