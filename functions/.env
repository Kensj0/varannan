# Tillåtna ursprung för inbjudningslänkar. createInvite validerar
# klientens window.location.origin mot denna lista — annars faller den
# tillbaka på http://localhost:3000 (se README, "Delningslänken pekade
# på fel domän"). Kommaseparerad om fler domäner behövs.
ALLOWED_APP_ORIGINS=https://varannan-familj.web.app,https://varannan-familj.firebaseapp.com
