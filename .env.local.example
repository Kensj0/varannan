# Kopiera till .env.local och fyll i värden från
# Firebase Console → Project settings → Your apps → Web app (SDK config)

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Console → Project settings → Cloud Messaging → Web Push
# certificates → generera ett nyckelpar. Krävs för push-notiser.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Sätt till "true" för att köra mot lokala Firebase-emulatorer (npm run emulators)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# calendarFeed-funktionens URL (ICS-prenumerationslänkarna i schemat).
# Utan denna renderas de länkarna tomma. Standardformatet för en
# 2:a generationens callable/HTTP-funktion är:
#   https://<region>-<projekt-id>.cloudfunctions.net/calendarFeed
# T.ex. för varannan-familj i us-central1:
NEXT_PUBLIC_CALENDAR_FEED_URL=https://us-central1-varannan-familj.cloudfunctions.net/calendarFeed
